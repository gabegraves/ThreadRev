# Fixtures are checksummed and regenerated byte-for-byte, so their line endings
# are content, not formatting. Without this a Windows checkout rewrites them to
# CRLF: `sha256sum -c fixtures/SHA256SUMS` then cannot read a single path, and
# a regenerated fixture differs from the committed one on every line.
* text=auto eol=lf

fixtures/SHA256SUMS  text eol=lf
fixtures/**/*.json   text eol=lf
*.py                 text eol=lf

# Generated documents are zips. Never touch them.
*.docx binary
*.xlsx binary
*.pdf  binary
