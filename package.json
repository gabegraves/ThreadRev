{
  "name": "agents-everywhere-starter-kit",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Starter kit for the Agents, Everywhere: Bots, Channels & More global hackathon.",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/*",
    "apps/channel",
    "apps/web",
    "apps/pet"
  ],
  "scripts": {
    "dev": "npm run dev:web",
    "dev:slack": "npm run dev --workspace channel",
    "channel:status": "npx --yes copilotkit@4.9.60 channels status --json",
    "channel:setup": "npx --yes copilotkit@4.9.60 channels setup --no-clipboard",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "dev:web": "npm run dev --workspace web",
    "test": "npm run test --workspaces --if-present",
    "verify": "npm run typecheck && npm test && npm run test:checkers",
    "test:checkers": "python3 -m unittest checkers/test_checkers.py",
    "replay:record": "TSX_TSCONFIG_PATH=apps/channel/tsconfig.json COPILOTKIT_TELEMETRY_DISABLED=true node --import tsx apps/channel/src/replay/record-cli.ts"
  },
  "overrides": {
    "@ag-ui/client": "0.0.59"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.23.1",
    "typescript": "^5.7.0"
  }
}
